{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (Apple clang)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (mingw-w64 cross; deps in build-deps/windows/install)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-w64-mingw32.cmake",
      "cacheVariables": {
        "EF_DEPS_PREFIX": "${sourceDir}/build-deps/windows/install",
        "EF_FFMPEG_PREFIX": "${sourceDir}/build-ffmpeg/windows/install"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86_64 (native gcc/clang, e.g. Steam Runtime sniper; deps in build-deps/linux/install)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "EF_DEPS_PREFIX": "${sourceDir}/build-deps/linux/install",
        "EF_FFMPEG_PREFIX": "${sourceDir}/build-ffmpeg/linux/install"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "linux-x64",   "configurePreset": "linux-x64" }
  ]
}
